@page
@model  ConsellComarcalElRetorn.Pages.PobleContribuents;
@{
    ViewData["Title"] = "Contribuents";
}
<h1>Llista de Poblacións</h1>

<ul>
    @foreach (var poble in Model.LlistaPobles)
    {
        <li>
            <a asp-page="/Contribuents" asp-route-Població="@poble"><strong>@poble</strong></a>
            
        </li>
    }
</ul>