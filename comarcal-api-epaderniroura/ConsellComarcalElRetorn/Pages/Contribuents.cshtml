@page "{Població}"
@model ConsellComarcalElRetorn.Pages.Contribuents

@if(Model.DadesContribuents != null)
{
    <h2>Contribuents de @Model.Població</h2>
    @foreach (var contribuent in Model.DadesContribuents)
    {
        <div>
            <br/><h6>- @contribuent.Nom (@contribuent.Dni)</h6> 
            <a class="btn btn-primary" style="background-color:mediumseagreen" a href="/Habitatge/@Model.Població">Edificis</a>

            <a class="btn btn-primary" style="background-color:lightseagreen" a href="/TaxaContribuent/@Model.Població/@contribuent.Dni">Rebuts</a>
            <br/>
           
        </div>
    }
}

else
{
    <p>No s'ha trobat dades per aquesta població</p>
}